# Atlas is deliberately paper-only by default.
ATLAS_EXECUTION_MODE=PAPER
ATLAS_EXCHANGE=binance_global
ATLAS_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
ATLAS_MARKET_INTERVAL=10
ATLAS_WEB_HOST=127.0.0.1
ATLAS_WEB_PORT=8000

# Only required by exchange features that use authenticated endpoints.
BINANCE_API_KEY=
BINANCE_API_SECRET=
