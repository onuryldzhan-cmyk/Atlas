# =============================================================================
# PROJECT ATLAS AI
# .gitignore
# =============================================================================
#
# Policy:
# - Keep source code reproducible.
# - Keep generated/runtime/local artifacts out of Git.
# - Prevent accidental commits of credentials and secret material.
# - Do not broadly ignore legitimate source-code packages.
#
# IMPORTANT:
# atlas_os/secrets/ contains secret-management SOURCE CODE.
# It must remain trackable by Git.
# =============================================================================


# =============================================================================
# PYTHON
# =============================================================================

__pycache__/
*.py[cod]
*$py.class
*.so

.Python

build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/

*.egg-info/
.installed.cfg
*.egg


# =============================================================================
# VIRTUAL ENVIRONMENTS
# =============================================================================

venv/
ENV/
env/
.venv/


# =============================================================================
# IDE / EDITOR
# =============================================================================

.vscode/
.idea/

*.swp
*.swo
*~


# =============================================================================
# ENVIRONMENT VARIABLES
# =============================================================================

.env
.env.local

.env.*
!.env.example


# =============================================================================
# LOGS
# =============================================================================

logs/
*.log


# =============================================================================
# DATA / LARGE GENERATED FILES
# =============================================================================

data/*.csv
data/*.csv.gz
data/*.parquet

# JSON files may be legitimate source-controlled fixtures/configuration.
!data/*.json


# =============================================================================
# OPERATING SYSTEM FILES
# =============================================================================

.DS_Store
Thumbs.db


# =============================================================================
# TESTING / COVERAGE
# =============================================================================

.coverage
htmlcov/
.pytest_cache/


# =============================================================================
# JUPYTER
# =============================================================================

.ipynb_checkpoints/


# =============================================================================
# ATLAS GENERATED OUTPUT
# =============================================================================

backtest_results/
paper_trading_logs/


# =============================================================================
# DATABASES
# =============================================================================

*.db
*.sqlite
*.sqlite3


# =============================================================================
# PRIVATE KEYS / CERTIFICATES
# =============================================================================

*.pem
*.key
*.p12
*.pfx
*.crt
*.cer


# =============================================================================
# CREDENTIAL / SECRET DIRECTORIES
# =============================================================================
#
# General protection remains enabled.
#
# WARNING:
# atlas_os/secrets/ is an Atlas Python source package.
# Explicit exceptions below ensure it remains trackable.
# =============================================================================

secrets/
credentials/


# =============================================================================
# ATLAS SECRET-MANAGEMENT SOURCE PACKAGE
# =============================================================================
#
# These files contain secret-management IMPLEMENTATION CODE,
# not secret values.
#
# Do not remove these exceptions unless the package architecture changes.
# =============================================================================

!atlas_os/secrets/
!atlas_os/secrets/__init__.py
!atlas_os/secrets/secrets_manager.py


# =============================================================================
# ATLAS RUNTIME-GENERATED STATE
# =============================================================================

/memory_data/
/paper_trades.json
/data/trades.json

# STATE-MOVE-1 (2026-09-18, ADR-0007): the durable state root and the market
# archive moved to C:\AtlasState via ATLAS_STATE_DIRECTORY /
# ATLAS_MARKET_ARCHIVE_DIRECTORY. The repository copies were renamed in place
# rather than deleted, which took them out from under the rules above and the
# data/market_archive/*.sqlite3 rules below. They are retired local state and
# must never enter history - keep them ignored at their new names too.
/memory_data.relocated_20260918/
/memory_data_backup_20260915.relocated_20260918/
/paper_trades.json.legacy_backup_20260915.relocated_20260918
/data/market_archive.relocated_20260918/


# =============================================================================
# END
# =============================================================================

reports/observability/test_results.junit.xml
reports/observability/test_results.meta.json
reports/observability/telemetry_summary.json

data/market_archive/*.sqlite3
data/market_archive/*.sqlite3-shm
data/market_archive/*.sqlite3-wal

# Research Evidence Store (ADR-0008). This is the installation-anchored
# DEFAULT root, used when ATLAS_EVIDENCE_DIRECTORY is unset; the operator's
# configured root lives outside the repository entirely.
/evidence_store/

# =============================================================================
# QUARANTINE
# =============================================================================
#
# Holding area for unattributed / unreviewed artifacts pending triage.
# Must never enter history via a bulk `git add -A`.

_quarantine/
